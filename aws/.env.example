# Copy to aws/.env (and to ~/carla-rl/project/.env on the instance) and fill in.
# No third-party/model APIs are needed — this project only talks to the local
# CARLA server and, for backup, AWS S3.

# AWS credentials used by sync_to_s3.sh to push checkpoints/logs to S3.
# Use the carla-rl-user access key created for this project (not your root key).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# S3 bucket created for this project (see aws/bucket_name.txt)
S3_BUCKET=carla-rl-checkpoints-026243800640
